:root {
  --bg: #f4f6fb;
  --panel: #ffffff;
  --panel-soft: #eef3ff;
  --primary: #4f46e5;
  --primary-dark: #3730a3;
  --primary-soft: rgba(79, 70, 229, 0.1);
  --text: #1f2937;
  --muted: #6b7280;
  --border: #e5e7eb;
  --success: #16a34a;
  --warning: #f59e0b;
  --danger: #dc2626;
  --shadow: 0 18px 40px rgba(17, 24, 39, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 50%, #eef7ff 100%);
  color: var(--text);
}

a {
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

.page-shell {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.topbar {
  padding-bottom: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.intro-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 20px 14px;
  margin-bottom: 20px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.08), rgba(124, 58, 237, 0.06));
  border: 1px solid rgba(79, 70, 229, 0.12);
}

.intro-banner h2 {
  margin: 6px 0 0;
  font-size: clamp(1.3rem, 2vw, 1.8rem);
}

.summary-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 10px 16px;
  background: rgba(255, 255, 255, 0.7);
  color: var(--primary-dark);
  border: 1px solid rgba(79, 70, 229, 0.12);
  font-weight: 700;
  font-size: 0.82rem;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
}

.view-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(79, 70, 229, 0.08);
  color: var(--primary-dark);
  font-weight: 700;
  border: 1px solid rgba(79, 70, 229, 0.16);
  transition: background 0.2s ease, transform 0.2s ease;
}

.view-link:hover {
  background: rgba(79, 70, 229, 0.12);
  transform: translateY(-1px);
}

.brand-mark {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
  color: white;
  display: grid;
  place-items: center;
  font-size: 1.5rem;
  font-weight: 700;
  box-shadow: var(--shadow);
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  font-size: 0.72rem;
  color: var(--muted);
}

h1 {
  margin: 4px 0 0;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
}

.form-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 28px;
}

.progress-panel {
  margin-bottom: 26px;
}

.progress-header,
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-header {
  margin-bottom: 12px;
  font-weight: 600;
  color: var(--muted);
}

.progress-bar {
  height: 10px;
  border-radius: 999px;
  background: var(--panel-soft);
  overflow: hidden;
  border: 1px solid var(--border);
}

.progress-fill {
  height: 100%;
  width: 16.66%;
  background: linear-gradient(90deg, var(--primary) 0%, #7c3aed 100%);
  border-radius: inherit;
  transition: width 0.25s ease;
}

.step-indicator {
  margin-top: 14px;
  gap: 8px;
}

.step-dot {
  flex: 1;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: var(--panel-soft);
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 700;
  border: 1px solid transparent;
}

.step-dot.active {
  background: var(--primary-soft);
  color: var(--primary-dark);
  border-color: rgba(79, 70, 229, 0.2);
}

.step-dot.completed {
  background: var(--success);
  color: white;
}

.form-step {
  display: none;
  animation: fadeIn 0.25s ease;
}

.form-step.active {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-heading {
  margin-bottom: 20px;
}

.section-heading p {
  margin: 0 0 6px;
  color: var(--primary);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.72rem;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px 22px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field-group.full-width {
  grid-column: 1 / -1;
}

label {
  font-weight: 600;
  color: var(--text);
}

.required {
  color: var(--danger);
}

input,
select,
textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  background: #fff;
  color: var(--text);
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: rgba(79, 70, 229, 0.7);
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
}

input::placeholder,
textarea::placeholder {
  color: #9ca3af;
}

textarea {
  resize: vertical;
  min-height: 100px;
}

small {
  color: var(--muted);
}

.checkbox-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
  border: 1px solid var(--border);
  background: #fbfcff;
  border-radius: 14px;
  padding: 14px;
}

.checkbox-grid label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 500;
  color: var(--text);
}

.checkbox-grid input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: var(--primary);
}

.upload-panel {
  border: 1px dashed #b0c1ff;
  background: linear-gradient(135deg, #f5f7ff 0%, #eef4ff 100%);
  border-radius: 18px;
  padding: 26px 20px;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 28px 18px;
  border: 1px solid rgba(79, 70, 229, 0.15);
  border-radius: 14px;
  background: white;
  cursor: pointer;
  text-align: center;
}

.upload-box input {
  display: none;
}

.upload-title {
  font-size: 1.08rem;
  font-weight: 700;
}

.upload-subtitle {
  color: var(--muted);
}

.skip-toggle {
  margin-top: 18px;
}

.skip-toggle label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 500;
}

.skip-toggle input {
  width: 18px;
  height: 18px;
  accent-color: var(--primary);
}

.form-actions {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.btn {
  border: none;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  padding: 12px 22px;
  min-width: 120px;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
  color: white;
}

.btn-secondary {
  background: #f3f4f6;
  color: var(--text);
}

.error-text {
  font-size: 0.82rem;
  color: var(--danger);
  min-height: 1.2em;
}

.hidden {
  display: none !important;
}

.practice-card {
  margin-top: 30px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 28px;
}

.practice-layout {
  display: grid;
  grid-template-columns: 220px minmax(0, 1.4fr) 260px;
  gap: 20px;
  align-items: start;
}

.practice-panel {
  background: #f8faff;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}

.subject-panel h3,
.tracker-panel h3,
.subject-breakdown h4,
.attempts-panel h4 {
  margin-top: 0;
  margin-bottom: 14px;
}

.subject-tabs {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.subject-tab {
  border: 1px solid var(--border);
  background: white;
  color: var(--text);
  border-radius: 12px;
  padding: 10px 12px;
  text-align: left;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.subject-tab.active {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(124, 58, 237, 0.08));
  border-color: rgba(79, 70, 229, 0.22);
  color: var(--primary-dark);
}

.state-block {
  padding: 24px 18px;
  border-radius: 14px;
  background: rgba(79, 70, 229, 0.04);
  color: var(--muted);
  font-weight: 600;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  color: var(--muted);
  font-weight: 700;
}

.subject-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(79, 70, 229, 0.08);
  color: var(--primary-dark);
  font-size: 0.8rem;
}

.question-text {
  margin: 0 0 18px;
  line-height: 1.6;
  font-size: clamp(1.08rem, 1.7vw, 1.5rem);
}

.answer-options {
  display: grid;
  gap: 12px;
}

.practice-option {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  background: white;
  border-radius: 12px;
  padding: 12px 14px;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.practice-option input {
  width: 18px;
  height: 18px;
  accent-color: var(--primary);
}

.practice-option.selected {
  border-color: rgba(79, 70, 229, 0.42);
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
  background: rgba(79, 70, 229, 0.03);
}

.quiz-actions {
  margin-top: 22px;
  padding-top: 0;
  border-top: none;
}

.result-card {
  padding: 18px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.08), rgba(79, 70, 229, 0.06));
  border: 1px solid rgba(34, 197, 94, 0.18);
}

.result-card h4 {
  margin-top: 0;
  margin-bottom: 10px;
}

.result-score {
  font-size: clamp(1.6rem, 2vw, 2.1rem);
  font-weight: 800;
  margin-bottom: 10px;
}

.review-list {
  display: grid;
  gap: 10px;
  margin-top: 14px;
}

.review-item {
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  padding: 12px;
}

.review-item.correct {
  border-color: rgba(22, 163, 74, 0.3);
}

.review-item.incorrect {
  border-color: rgba(220, 38, 38, 0.24);
}

.review-item strong {
  display: block;
  margin-bottom: 6px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 20px;
}

.stat-box {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 10px;
  text-align: center;
}

.stat-label {
  display: block;
  color: var(--muted);
  font-size: 0.75rem;
  margin-bottom: 4px;
}

.stat-box strong {
  font-size: 1.2rem;
}

.subject-summary-list,
.attempt-history {
  display: grid;
  gap: 8px;
}

.summary-item,
.history-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
}

.history-item {
  display: grid;
  gap: 4px;
}

.history-item small {
  color: var(--muted);
}

@media (max-width: 800px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .page-shell {
    padding-left: 14px;
    padding-right: 14px;
  }

  .form-card {
    padding: 20px 16px;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .btn {
    width: 100%;
  }

  .intro-banner {
    flex-direction: column;
    align-items: flex-start;
  }

  .practice-layout {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}


/* AI Tutor Chatbot */
#chatbot {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 9999;
  font-family: Arial, sans-serif;
}

#chat-toggle {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  color: white;
  border: none;
  border-radius: 999px;
  padding: 14px 20px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 700;
  box-shadow: 0 12px 28px rgba(79, 70, 229, 0.28);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#chat-toggle:hover {
  transform: translateY(-1px);
  box-shadow: 0 16px 32px rgba(79, 70, 229, 0.32);
}

#chat-window {
  width: 340px;
  height: 430px;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 20px;
  box-shadow: 0 20px 48px rgba(15, 23, 42, 0.18);
  margin-bottom: 12px;
  overflow: hidden;
}

#chat-header {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  color: white;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
}

#chat-close {
  background: transparent;
  border: none;
  color: white;
  cursor: pointer;
  font-size: 18px;
  opacity: 0.9;
}

#chat-messages {
  height: 315px;
  overflow-y: auto;
  padding: 12px;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
}

.bot-message,
.user-message {
  padding: 10px 12px;
  border-radius: 12px;
  margin-bottom: 10px;
  max-width: 85%;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 1.5;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
}

.bot-message {
  background: #e5e7eb;
  color: #111827;
  border-top-left-radius: 4px;
}

.user-message {
  background: linear-gradient(135deg, #4f46e5 0%, #6d5ef6 100%);
  color: white;
  margin-left: auto;
  border-top-right-radius: 4px;
}

#chat-form {
  display: flex;
  gap: 8px;
  padding: 10px 12px 12px;
  border-top: 1px solid #eef2ff;
  background: rgba(255, 255, 255, 0.9);
}

#chat-input {
  flex: 1;
  min-width: 0;
  padding: 10px 12px;
  border: 1px solid #dbe4ff;
  border-radius: 10px;
  outline: none;
  background: #fff;
}

#chat-input:focus {
  border-color: rgba(79, 70, 229, 0.7);
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
}

#chat-form button {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 700;
}

#chat-form button:disabled {
  opacity: 0.6;
  cursor: wait;
}

#chat-window[hidden] {
  display: none;
}

@media (max-width: 420px) {
  #chatbot {
    right: 12px;
    bottom: 12px;
  }

  #chat-window {
    width: calc(100vw - 24px);
    height: 400px;
  }

  #chat-messages {
    height: 285px;
  }
}

.platform-preview {
  margin-top: 28px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.preview-card {
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(255, 255, 255, 0.9);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: 22px 20px;
}

.preview-card h3 {
  margin: 8px 0 10px;
}

.preview-card p {
  margin: 0 0 18px;
  color: var(--muted);
  line-height: 1.6;
}

.dashboard-body {
  background: linear-gradient(180deg, #edf5ff 0%, #f8fafc 100%);
}

.dashboard-shell {
  max-width: 1500px;
  margin: 0 auto;
  padding: 22px 20px 50px;
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 24px;
}

.sidebar {
  position: sticky;
  top: 24px;
  height: fit-content;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  padding: 22px 18px;
  box-shadow: var(--shadow);
}

.sidebar-brand {
  margin-bottom: 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.sidebar-brand h2 {
  margin: 0;
  color: #fff;
}

.sidebar .eyebrow {
  color: rgba(255, 255, 255, 0.7);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  display: block;
  padding: 11px 12px;
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.82);
  font-weight: 600;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(79, 70, 229, 0.2);
  color: white;
}

.sidebar-card {
  margin-top: 22px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(99, 102, 241, 0.12);
  border-radius: 18px;
  padding: 16px 14px;
  display: grid;
  gap: 12px;
}

.sidebar-card strong {
  color: white;
  font-size: 0.95rem;
}

.btn-small {
  min-width: 0;
  padding: 10px 16px;
  text-align: center;
}

.workspace-main {
  min-width: 0;
}

.workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin-bottom: 20px;
}

.workspace-header h1 {
  margin: 6px 0 0;
}

.workspace-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.stat-card {
  padding: 18px 16px;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: var(--shadow);
}

.stat-card strong {
  display: block;
  margin: 8px 0 4px;
  font-size: clamp(1.3rem, 2vw, 1.9rem);
}

.stat-card small {
  color: var(--muted);
}

.panel-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.workspace-panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  box-shadow: var(--shadow);
  padding: 22px 20px;
}

.feature-panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
}

.feature-panel h3 {
  margin: 0;
}

.feature-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
}

.placeholder-panel {
  padding: 28px 24px;
}

.placeholder-panel h2 {
  margin-top: 0;
  margin-bottom: 12px;
}

.placeholder-panel p {
  margin-bottom: 22px;
  color: var(--muted);
  line-height: 1.7;
}

.job-form {
  display: grid;
  gap: 18px;
}

.job-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.job-full {
  grid-column: 1 / -1;
}

.job-inline-row {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
}

.checkbox-row {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

.checkbox-row input {
  width: 18px;
  height: 18px;
  accent-color: var(--primary);
}

.job-results-list {
  display: grid;
  gap: 18px;
  margin-top: 20px;
}

.job-card {
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 20px;
  padding: 22px;
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.9), rgba(255, 255, 255, 0.98));
  box-shadow: var(--shadow-soft, 0 12px 25px rgba(15, 23, 42, 0.05));
}

.job-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 12px;
}

.job-header-row h3 {
  margin: 8px 0 0;
  font-size: clamp(1.3rem, 2vw, 1.6rem);
}

.role-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(79, 70, 229, 0.1);
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 0.75rem;
}

.job-score {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  padding: 10px 12px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(59, 130, 246, 0.12));
  color: #0f172a;
  font-weight: 800;
}

.job-summary {
  margin: 0 0 16px;
  color: var(--muted);
  line-height: 1.7;
}

.job-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.job-meta-grid h4 {
  margin: 0 0 10px;
  font-size: 0.92rem;
  color: var(--text);
}

.pill-list,
.bullet-list {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 6px;
  color: var(--muted);
  line-height: 1.6;
}

.positive-list li {
  color: #136c48;
}

.warning-list li {
  color: #9a4d00;
}

.job-guidance-box {
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  padding-top: 14px;
  color: var(--muted);
}

.job-guidance-box strong {
  display: block;
  margin-bottom: 8px;
  color: var(--text);
}

@media (max-width: 820px) {
  .job-form-grid,
  .job-meta-grid {
    grid-template-columns: 1fr;
  }

  .job-actions {
    align-items: stretch;
  }

  .job-actions .btn {
    width: 100%;
  }
}

.tutor-panel {
  padding: 0;
  overflow: hidden;
}

.chat-shell {
  display: flex;
  flex-direction: column;
  min-height: 620px;
}

.chat-shell-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  padding: 20px 22px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.08), rgba(124, 58, 237, 0.04));
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.chat-shell-header h2 {
  margin: 6px 0 0;
  font-size: clamp(1.2rem, 2vw, 1.7rem);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(79, 70, 229, 0.12);
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 0.78rem;
}

.workspace-chat-messages {
  flex: 1;
  min-height: 380px;
  max-height: 500px;
  overflow-y: auto;
  padding: 18px 16px;
  background: linear-gradient(180deg, #f9fbff 0%, #eef2ff 100%);
}

.workspace-chat-form {
  display: flex;
  gap: 12px;
  padding: 16px 18px 18px;
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.75);
}

.workspace-chat-form input {
  flex: 1;
  min-width: 0;
}

.workspace-practice {
  padding: 0;
  overflow: hidden;
}

.workspace-practice .practice-card {
  margin-top: 0;
  box-shadow: none;
  border-radius: 0;
  border: none;
  padding: 20px;
}

@media (max-width: 1100px) {
  .dashboard-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
    height: auto;
  }
}

@media (max-width: 900px) {
  .platform-preview,
  .panel-grid,
  .stats-row {
    grid-template-columns: 1fr;
  }

  .workspace-header {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 620px) {
  .dashboard-shell {
    padding-left: 12px;
    padding-right: 12px;
  }

  .workspace-actions {
    width: 100%;
  }

  .workspace-actions .btn {
    width: 100%;
  }

  .workspace-chat-form {
    flex-direction: column;
  }
}
